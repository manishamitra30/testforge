# Copy to .env (which git ignores) to override the local defaults in docker-compose.yml.

POSTGRES_PASSWORD=testforge

# Must be Base64. Generate one with:  openssl rand -base64 32
JWT_SECRET=

# Exact origin(s) of the frontend, comma separated, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to false for a small backend image without Chromium (automated runs are then unavailable).
WITH_AUTOMATION=true

# Only change these if the browser reaches the backend through a different address.
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WS_URL=
